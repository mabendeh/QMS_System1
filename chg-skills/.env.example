# PostgreSQL connection (private network only)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/chg_skills?schema=public"
# Used only by the automated test suite (a separate, disposable database)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/chg_skills_test?schema=public"
# 64 random hex characters: openssl rand -hex 32
SESSION_SECRET=""
# Password given to the fictional demo accounts created by `npm run db:seed`.
# Leave empty to have the seed generate one and print it once.
SEED_DEMO_PASSWORD=""
# Where uploaded evidence files are stored (outside the web root)
UPLOAD_DIR="./var/uploads"
# Set to "true" only when served over HTTPS (marks the session cookie Secure)
COOKIE_SECURE="false"
